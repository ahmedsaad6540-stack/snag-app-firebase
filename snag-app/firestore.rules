rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().approved != false
        && userDoc().disabled != true
        && userDoc().deleted != true;
    }

    function isAdmin() {
      return isApproved() && userDoc().role == "admin";
    }

    // Users collection:
    // - A signed-in user can read their own profile (to check approval/role status)
    // - Admins can read and manage all user profiles
    // - Newly registered users can create their own pending profile (role: "user", approved: false)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    // Snags collection
    match /snags/{snagId} {
      allow read, create, update: if isApproved();
      allow delete: if isApproved();
    }

    // Units, Stores, Custom Lists, Custom Items, Locations, Notifications
    match /units/{unitId} {
      allow read, write: if isApproved();
    }

    match /stores/{storeId} {
      allow read, write: if isApproved();
    }

    match /custom_lists/{listId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    match /custom_items/{itemId} {
      allow read, create, update: if isApproved();
      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read, write: if isApproved();
    }

    match /notifications/{notifId} {
      allow read, write: if isApproved();
    }

    match /restroom_inspections/{rowId} {
      allow read, write: if isApproved();
    }

    match /restroom_status/{restroomKey} {
      allow read, write: if isApproved();
    }
  }
}
