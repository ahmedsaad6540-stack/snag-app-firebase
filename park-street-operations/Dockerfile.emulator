FROM node:20-alpine

# Install OpenJDK 17 (required by cloud-firestore-emulator) and utilities
RUN apk add --no-cache openjdk17-jre bash curl

# Install exact compatible firebase-tools version
RUN npm install -g firebase-tools@13.35.1

WORKDIR /emulator

EXPOSE 8080

CMD ["firebase", "emulators:start", "--only", "firestore", "--project", "snag-ops-staging", "--import=/emulator/data", "--export-on-exit=/emulator/data"]
