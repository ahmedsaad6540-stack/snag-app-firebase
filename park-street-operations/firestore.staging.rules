rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicit deny-all on any legacy production collections if ever queried
    match /users/{userId} {
      allow read, write: if false;
    }
    match /snags/{snagId} {
      allow read, write: if false;
    }
    match /companies/{companyId} {
      allow read, write: if false;
    }

    // Isolated Slack Staging Namespace
    match /slack_ops_staging_workspaces/{teamId} {
      // Workspace root configuration document (read-only for members)
      allow read: if request.auth != null;
      allow write: if false;

      // Tickets (Work Orders) subcollection
      match /tickets/{ticketId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.teamId == teamId
                      && request.resource.data.isDemo == true
                      && request.resource.data.source == 'slack-staging';
        allow update: if request.auth != null
                      && resource.data.teamId == teamId
                      && resource.data.isDemo == true;
        allow delete: if request.auth != null && resource.data.teamId == teamId;
      }

      // Operational modules (Park Street, Restrooms, Units, Stores, Permits, etc.)
      match /{moduleCollection}/{docId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.resource.data.teamId == teamId
                              && request.resource.data.isDemo == true;
        allow delete: if request.auth != null && resource.data.teamId == teamId;
      }
    }
  }
}
